@inject NavigationManager _navManager;
<div class="col-lg-12">
    <div class="card mb-3 p-3">
        <div class="row g-0">
            <div class="col-md-3 text-center ">
                <img src="/Logo.webp" class="img-fluid rounded-start m-auto" />
            </div>
            <div class="col-md-7">
                <div class="card-body">
                    @ChildContent
                </div>
            </div>
            <div class="col-md-2">
                @if (!IsMainPage)
                {
                    <button class="btn btn-success btn-md" onclick="history.go(-1)">@Localizer.GetUi("Back")</button>
                }
                <button class="btn btn-success btn-md" @onclick=@(()=>OnLanguageChanged())>@(lang == "en" ? @Localizer.GetUi("Arabic") : @Localizer.GetUi("English"))</button>
            </div>
        </div>
    </div>
</div>
@code {
    [Parameter]
    public bool IsMainPage { get; set; }
    [Parameter]
    public string lang { get; set; }
    [Parameter]
    public RenderFragment ChildContent { get; set; }
    [Parameter]
    public EventCallback<string> LanguageChanged { get; set; }
    public async Task OnLanguageChanged()
    {
        var language = lang == "en" ? "ar" : "en";
        await LanguageChanged.InvokeAsync(language);
    }
}
